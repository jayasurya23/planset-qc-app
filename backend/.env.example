# Copy to backend/.env for local dev (backend/.env is gitignored).
# In Azure these are set as App Service application settings instead — never
# commit real keys.

# --- AI provider ---
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...your-key...
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MODEL_DEEP=gpt-4.1          # optional: heavier model for deep passes
# OPENAI_SEED=42                     # optional: best-effort determinism for reproducible runs / clean
#                                    # before-after diffs. Unset = normal sampling. Best-effort only
#                                    # (a model/infra update can still shift output); does not resolve
#                                    # genuine model judgment differences on ambiguous drawings.

# To use Anthropic Claude instead (key from platform.claude.com Console;
# API billing is separate from claude.ai subscriptions):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...your-key...
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MODEL_DEEP=claude-opus-5
# ANTHROPIC_MAX_TOKENS=16000

# To use Gemini instead:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=...your-key...
# GEMINI_MODEL=gemini-2.5-flash

# --- Chat copilot (optional; independent of AI_PROVIDER) ---
# CHAT_PROVIDER=openai               # openai (default) or anthropic
# CHAT_MODEL=                        # default: the provider's deep model

# --- Tuning (optional) ---
# AI_PARALLELISM=6
# AI_TIMEOUT=90
# AI_RETRIES=2

# --- Storage ---
# Where runs, SQLite, uploads, and artifacts are written. Leave unset locally
# (defaults to backend/data). Azure sets this to /home/data (persistent).
# PLANSET_DATA_DIR=/home/data
