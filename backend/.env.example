# Copy to backend/.env for local dev (backend/.env is gitignored).
# In Azure these are set as App Service application settings instead — never
# commit real keys.

# --- AI provider ---
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...your-key...
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_MODEL_DEEP=gpt-4.1          # optional: heavier model for deep passes

# To use Gemini instead:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=...your-key...
# GEMINI_MODEL=gemini-2.5-flash

# --- Tuning (optional) ---
# AI_PARALLELISM=6
# AI_TIMEOUT=90
# AI_RETRIES=2

# --- Storage ---
# Where runs, SQLite, uploads, and artifacts are written. Leave unset locally
# (defaults to backend/data). Azure sets this to /home/data (persistent).
# PLANSET_DATA_DIR=/home/data
